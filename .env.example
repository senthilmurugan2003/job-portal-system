# Database Configuration
DATABASE_URL=sqlite:///job_portal_db.db

# Security & JWT Keys
SECRET_KEY=default-job-portal-secret-key-2026-super-secure-key-32bytes
JWT_SECRET_KEY=default-jwt-secret-key-2026-super-secure-key-32bytes

# Email SMTP Configuration (Gmail SMTP or your provider)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Frontend Base URL
FRONTEND_URL=http://127.0.0.1:5500/frontend
